# Python reads process environment only; it does not load .env automatically.
# Compose may interpolate an optional .env; never commit actual credentials.
# Compose explicitly sends GOOGLE_API_KEY only to the backend at runtime.
UPLOAD_MAX_BYTES=5242880
DATASET_TTL_SECONDS=1800
MAX_ACTIVE_DATASETS=20
# Required only for real POST /analyze requests. Never commit a real key.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_TIMEOUT_SECONDS=30
GOOGLE_MAX_OUTPUT_TOKENS=1200
# Frontend process settings; no provider key is needed in this terminal.
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_REQUEST_TIMEOUT_SECONDS=30
FRONTEND_ANALYSIS_TIMEOUT_SECONDS=300

# Compose Streamlit server cap in whole MiB; keep consistent with UPLOAD_MAX_BYTES.
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=5

# Set true only after checking the AI Studio project is Free and billing is disabled.
GOOGLE_FREE_TIER_CONFIRMED=false
